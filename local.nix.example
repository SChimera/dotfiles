{
  haven = {
    username = "youruser";
    hostConfig = {
      git = {
        name = "Your Name";
        email = "you@personal.com";
        signingKey = "~/.ssh/id_ed25519_haven";
      };
      ssh.identityFile = "~/.ssh/id_ed25519_haven";
      workDirs = [ "code/personal" ];
    };
  };

